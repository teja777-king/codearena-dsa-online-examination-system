{
  "name": "codearena-dsa",
  "version": "1.0.0",
  "description": "CodeArena DSA — Intelligent Online Examination System for University DSA Courses",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "seed": "node server/seed/seed.js",
    "test": "node server/tests/runTests.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "dsa",
    "online-examination-system",
    "react",
    "nodejs",
    "mongodb",
    "express",
    "data-structures",
    "algorithms"
  ],
  "author": "CodeArena Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
